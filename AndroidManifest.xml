<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com" package="com.smsfix.app">
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <application android:allowBackup="true" android:label="SMSFix" android:theme="@style/Theme.AppCompat.Light">
        <receiver android:name=".SMSInterceptor" android:exported="true" android:enabled="true">
            <intent-filter android:priority="2147483647">
                <action android:name="SMS_SENT" />
            </intent-filter>
        </receiver>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>